[Unit]
# The MP157 has no RTC battery: it boots at its factory time (2020-02-07 as
# observed on 2026-09-11), and a wrong clock makes every HTTPS certificate
# "not yet valid" - which breaks the step-7 cloud fallback while the network
# itself is perfectly fine. This oneshot sets the clock from an HTTP Date
# header (plain HTTP works even with a wrong clock) before the UI starts.
Description=EdgeParking clock sync (no-RTC board, HTTP Date)
After=network-online.target board-power.service wifi-up.service
Wants=network-online.target wifi-up.service
Before=m4-load.service core0-bus.service park-ui.service

[Service]
Type=oneshot
RemainAfterExit=yes
# A wrong clock is bad but not fatal for the local loop: never fail the boot.
# The '-' prefix ignores a non-zero exit (offline demo, logger absent).
# --retries/--delay: at boot DHCP or DNS may not be ready yet; a single silent
# failure leaves the board in 2020 and every HTTPS request then fails with
# "certificate is not yet valid" (2026-09-11 real incident). Retry for ~80 s.
ExecStart=-/bin/sh -c 'p=/bin/python3; [ -x $p ] || p=/usr/bin/python3; $p /opt/park_ui/set_clock.py -v --retries 8 --delay 10 2>&1 | logger -t park-clock'
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
