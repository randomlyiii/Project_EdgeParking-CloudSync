# /etc/park-ui.env - SAMPLE / TEMPLATE (safe to commit)
#
# Optional environment for park-ui.service (EnvironmentFile=-/etc/park-ui.env).
# Deploy with:  install -m 600 sample_park-ui.env /etc/park-ui.env
#
# Everything below is COMMENTED OUT on purpose: copying this file changes
# nothing until you enable a line. Values shown are the built-in defaults.
#
# PRIVACY: keep this file free of secrets. systemd environment is visible to
# `systemctl show park-ui` (and to anything that can read /proc), so the API key
# belongs in /etc/park/cloud.conf (mode 600), not here.

# K210 preview / result uplink. DEFAULT = TCP relay from the RK3588 edge hub
# (rk3588_service/edge_hub.py): preview frames + K2:OK/NG results + logs all
# arrive over Ethernet, the LCD flow is unchanged. Set to EMPTY to fall back
# to the local serial console ($PARK_UI_TTY) with the K210 plugged into MP157.
#PARK_UI_K210_TCP=rk3588:8089

# K210 preview / result serial port (only used with PARK_UI_K210_TCP empty).
# Default /dev/ttyACM0 (the CH9102 bridge enumerates as cdc_acm once
# board-power.service has enabled the USB hub).
#PARK_UI_TTY=/dev/ttyACM0

# K210 image orientation is corrected in firmware (img.replace() in main.py);
# only override if the picture is wrong anyway: none | hmirror | flip180 | vflip
#PARK_UI_K210_FLIP=none

# WiFi interface used by the settings page (default wlan0).
#PARK_UI_WIFI=wlan0

# Path of the wpa_supplicant config the settings page rewrites.
#PARK_WPA_CONF=/etc/wpa_supplicant.conf

# Cloud settings file (default /etc/park/cloud.conf). Point it at a copy in
# /tmp to experiment without touching the key the LCD normally uses.
#PARK_CLOUD_CONF=/etc/park/cloud.conf

# Fallback source of the cloud API key when api_key= in cloud.conf is empty.
# Prefer cloud.conf: this one is inherited by child processes.
#DEEPSEEK_API_KEY=

# Qt platform options are set inside park-ui.service; override only if you know
# why (linuxfb has no window manager, the geometry is pinned in mainwindow.cpp).
#QT_QPA_PLATFORM=linuxfb:nocursor=1:size=1024x600
